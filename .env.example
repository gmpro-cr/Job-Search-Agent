# Job Search Agent — Environment Variables
# Copy this file to .env and fill in your values.
# Anything that touches a credential MUST live here, never in
# user_preferences.json (the load/save path strips credentials on both
# read and write).

# ---------------------------------------------------------------------------
# Web app
# ---------------------------------------------------------------------------

# Random secret for Flask session signing. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
FLASK_SECRET=

# Google OAuth client. Add <deployment-url>/auth/callback to the
# authorized redirect URIs in the Google Cloud Console first.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated allowlist of Google accounts permitted to sign in.
# Anyone outside the list is bounced back to /login.
ALLOWED_EMAILS=

# The "owner" account whose CV/preferences drive the shared cron scrape.
# The first user to sign in is auto-promoted to admin; OWNER_EMAIL is
# used by scrape_and_push.py when ALLOWED_EMAILS is empty.
OWNER_EMAIL=

# Enable the /auth/dev-login button (skips OAuth). LOCAL DEV ONLY.
# Never honoured when VERCEL=1.
ENABLE_DEV_LOGIN=0

# ---------------------------------------------------------------------------
# Database / Storage (Neon + Vercel Blob)
# ---------------------------------------------------------------------------

# Pooled Neon URL at runtime; direct URL for migrations / DDL.
DATABASE_URL=
DATABASE_URL_DIRECT=

# Vercel Blob (digests + PRDs). Falls back to data/blob_local/ when unset.
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Email / Notifications
# ---------------------------------------------------------------------------

# Gmail SMTP for email digests + cold outreach
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
EMAIL_RECIPIENT=

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_SCORE=65

# ---------------------------------------------------------------------------
# AI / Enrichment
# ---------------------------------------------------------------------------

# Apollo.io contact enrichment
APOLLO_API_KEY=

# OpenRouter API — used as the LLM fallback for the agent and NLP parser.
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google Gemini API — used by the PRD generator.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------

# Import API secret (GitHub Actions scraper → Render-hosted push endpoint)
IMPORT_SECRET=

# GitHub PAT (workflow scope) — required if you want the /api/scraper/
# trigger-github button to dispatch the scrape workflow from the web UI.
GITHUB_TOKEN=
GITHUB_REPO=gmpro-cr/Job-Search-Agent
