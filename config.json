{
  "portals": {
    "linkedin": {
      "enabled": true,
      "base_url": "https://www.linkedin.com/jobs/search/",
      "timeout": 30,
      "use_selenium": true,
      "max_pages": 5
    },
    "indeed": {
      "enabled": true,
      "base_url": "https://in.indeed.com/jobs",
      "timeout": 30,
      "use_selenium": true,
      "max_pages": 5
    },
    "naukri": {
      "enabled": true,
      "base_url": "https://www.naukri.com",
      "timeout": 30,
      "use_selenium": true,
      "max_pages": 5
    },
    "hiringcafe": {
      "enabled": true,
      "base_url": "https://hiring.cafe",
      "timeout": 30,
      "page_size": 50
    },
    "angellist": {
      "enabled": false,
      "base_url": "https://wellfound.com/jobs",
      "timeout": 30,
      "use_selenium": true,
      "max_pages": 3
    },
    "iimjobs": {
      "enabled": false,
      "base_url": "https://www.iimjobs.com",
      "timeout": 30,
      "use_selenium": true,
      "max_pages": 3
    },
    "cutshort": {
      "enabled": false,
      "base_url": "https://cutshort.io",
      "timeout": 20
    },
    "instahyre": {
      "enabled": false,
      "base_url": "https://www.instahyre.com",
      "timeout": 25
    },
    "remoteok": {
      "enabled": false,
      "base_url": "https://remoteok.com",
      "timeout": 20
    },
    "remotive": {
      "enabled": true,
      "base_url": "https://remotive.com",
      "timeout": 20
    },
    "reddit": {
      "enabled": false,
      "base_url": "https://www.reddit.com",
      "timeout": 20,
      "subreddits": [
        "forhire",
        "cscareerquestions"
      ]
    },
    "hackernews": {
      "enabled": true,
      "base_url": "https://news.ycombinator.com",
      "timeout": 20
    },
    "twitter": {
      "enabled": false,
      "base_url": "https://x.com",
      "timeout": 20,
      "max_results": 15
    },
    "lever": {
      "enabled": true,
      "timeout": 20,
      "companies": ["meesho", "cred", "paytm", "freshworks"]
    },
    "greenhouse": {
      "enabled": true,
      "timeout": 20,
      "companies": ["groww", "phonepe", "postman"]
    }
  },
  "scraping": {
    "thread_count": 4,
    "request_delay_min": 2,
    "request_delay_max": 5,
    "max_retries": 3,
    "portal_timeout": 30,
    "cache_expiry_hours": 12
  },
  "scoring": {
    "min_relevance_score": 65,
    "ollama_model": "llama3.2:3b",
    "ollama_timeout": 60,
    "use_ollama": true
  },
  "digest": {
    "open_in_browser": true,
    "keep_days": 90
  },
  "logging": {
    "log_file": "job_agent.log",
    "max_log_days": 30,
    "log_level": "INFO"
  }
}
